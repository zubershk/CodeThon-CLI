# ════════════════════════════════════════════════════════════════
#  CodeThon CLI — Environment Configuration
#  Copy this file to .env and fill in your keys.
# ════════════════════════════════════════════════════════════════

# ── AI PROVIDERS ──────────────────────────────────────────────
# Choose ONE provider. NVIDIA is free (no API key needed for most models).

## Option A: OpenAI (GPT-4o, GPT-4o-mini, o1, o3)
OPENAI_API_KEY=sk-your-key-here
# Or use the CODETHON_ prefixed version (takes priority):
CODETHON_OPENAI_KEY=

## Option B: NVIDIA (Free — Llama Nemotron, Mistral, DeepSeek)
# Most NVIDIA NIM models require no API key.
# Set only if you have an NVIDIA GPU Cloud key:
NVIDIA_API_KEY=
CODETHON_NVIDIA_KEY=

# ── DEFAULT MODEL ─────────────────────────────────────────────
# Set here OR use `ct model` command to switch interactively.
CODETHON_MODEL=gpt-4o-mini
